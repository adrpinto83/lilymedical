// LilyMedical - Schema de base de datos
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum RolUsuario {
  // Administrador del sistema: gestiona personal, respaldos y toda la parte
  // administrativa, pero no ve historias clínicas ni emite actos médicos.
  ADMIN
  MEDICO
  ADMINISTRATIVO
  // Fisiatra ayudante: registra la evolución y el progreso de los pacientes,
  // pero no emite récipes ni constancias (actos que exigen colegiatura) ni ve
  // la parte administrativa y financiera del consultorio.
  FISIATRA_AYUDANTE
  PACIENTE
}

enum SexoPaciente {
  MASCULINO
  FEMENINO
  OTRO
}

enum TipoEscala {
  BARTHEL
  OSWESTRY
  GONIOMETRICA
  EVA
  FUERZA_MUSCULAR
  PERSONALIZADA
}

enum EstadoAsistencia {
  ASISTIO
  INASISTIO
  CANCELO
}

enum TipoAdjunto {
  IMAGEN
  PDF
  INFORME
  OTRO
}

enum EstadoCita {
  PROGRAMADA
  CONFIRMADA
  ATENDIDA
  CANCELADA
  NO_ASISTIO
}

enum EstadoFactura {
  PENDIENTE
  PAGADA
  PARCIAL
  ANULADA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  SEGURO
  TRANSFERENCIA
  PAGO_MOVIL
  ZELLE
  // Compra financiada por Cashea: el paciente paga la inicial al consultorio
  // (con otro método) y Cashea liquida el resto semanalmente.
  CASHEA
}

enum TipoMovimientoInsumo {
  ENTRADA
  SALIDA
}

enum AccionLog {
  VER
  EDITAR
  CREAR
  ELIMINAR
}

enum TipoReceta {
  MEDICAMENTO
  ORDEN_TERAPIA
}

// ============================================================
// USUARIOS Y AUTENTICACIÓN
// ============================================================

model Usuario {
  id               String     @id @default(uuid())
  nombre           String
  apellido         String
  email            String     @unique
  passwordHash     String
  rol              RolUsuario
  especialidad     String? // ej. "Fisiatría", "Terapia Ocupacional" (para MEDICO)
  pacienteId       String?    @unique // vincula un login con rol PACIENTE a su ficha clínica (portal del paciente)
  activo           Boolean    @default(true)
  intentosFallidos Int        @default(0) // login: intentos de contraseña incorrectos consecutivos (Fase 13)
  bloqueadoHasta   DateTime? // login: bloqueado temporalmente tras superar LOGIN_MAX_INTENTOS (Fase 13)
  // Baja lógica: el usuario tenía historial (citas, sesiones, récipes...) y no
  // se pudo borrar sin romperlo. Sale de la lista del personal, no puede
  // entrar y su email queda libre; su nombre sigue en los registros pasados.
  eliminadoEn      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  paciente Paciente? @relation(fields: [pacienteId], references: [id])

  citasComoProfesional     Cita[]                 @relation("ProfesionalCitas")
  sesionesComoTerapeuta    Sesion[]               @relation("TerapeutaSesiones")
  evaluacionesRealizadas   EvaluacionFisiatrica[] @relation("EvaluadorEvaluaciones")
  bloqueosHorario          BloqueoHorario[]
  adjuntosSubidos          Adjunto[]              @relation("SubidoPorUsuario")
  pagosRegistrados         Pago[]                 @relation("RegistradoPorUsuario")
  pagosAnulados            Pago[]                 @relation("AnuladoPorUsuario")
  logsAcceso               LogAcceso[]
  movimientosInsumo        MovimientoInsumo[]
  mantenimientosEquipo     MantenimientoEquipo[]
  perfilMedico             PerfilMedico?
  recetasEmitidas          Receta[]               @relation("MedicoRecetas")
  constanciasEmitidas      ConstanciaMedica[]     @relation("MedicoConstancias")
  informesEmitidos         InformeMedico[]        @relation("MedicoInformes")
  presupuestosCreados      Presupuesto[]          @relation("PresupuestosCreados")
  plantillasReceta         PlantillaReceta[]
  planesEjerciciosEmitidos PlanEjercicios[]       @relation("MedicoPlanesEjercicios")
  fotosGaleriaSubidas      FotoGaleria[]          @relation("UsuarioFotosGaleria")

  @@map("usuarios")
}

// ============================================================
// ASEGURADORAS / CONVENIOS
// ============================================================

model Aseguradora {
  id                   String   @id @default(uuid())
  nombre               String
  tipoConvenio         String?
  condiciones          String?
  contactoNombre       String?
  contactoTelefono     String?
  // % que cubre la aseguradora por servicio (el resto queda a cargo del paciente).
  // Si es null, la factura se cobra completa a quien se le facture (sin split automático).
  porcentajeCobertura  Float?
  requiereAutorizacion Boolean  @default(false)
  topeMontoPorSesion   Decimal? @db.Decimal(10, 2)
  activo               Boolean  @default(true)
  createdAt            DateTime @default(now())

  pacientes      PacienteAseguradora[]
  tarifas        Tarifa[]
  facturas       Factura[]
  autorizaciones AutorizacionSeguro[]

  @@map("aseguradoras")
}

enum EstadoAutorizacion {
  PENDIENTE
  APROBADA
  RECHAZADA
}

// Control de pre-autorizaciones que exigen las HCM/convenios (PDVSA, Sicoprosa,
// etc.) antes de atender un paquete de sesiones o un procedimiento.
model AutorizacionSeguro {
  id                  String             @id @default(uuid())
  pacienteId          String
  aseguradoraId       String
  numeroAutorizacion  String?
  sesionesAutorizadas Int?
  estado              EstadoAutorizacion @default(PENDIENTE)
  fechaSolicitud      DateTime           @default(now())
  vigenciaHasta       DateTime?
  notas               String?
  createdAt           DateTime           @default(now())

  paciente    Paciente    @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  aseguradora Aseguradora @relation(fields: [aseguradoraId], references: [id])
  facturas    Factura[]

  @@index([pacienteId])
  @@map("autorizaciones_seguro")
}

// ============================================================
// PACIENTES
// ============================================================

model Paciente {
  id                         String       @id @default(uuid())
  nombres                    String
  apellidos                  String
  documento                  String       @unique
  fechaNacimiento            DateTime
  sexo                       SexoPaciente
  telefono                   String
  email                      String?
  instagram                  String?
  direccion                  String?
  contactoEmergenciaNombre   String?
  contactoEmergenciaTelefono String?
  activo                     Boolean      @default(true)
  // Año de la última felicitación de cumpleaños enviada por correo: evita
  // repetirla si el job corre varias veces el mismo día.
  cumpleanosFelicitadoAnio   Int?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  aseguradoras         PacienteAseguradora[]
  autorizacionesSeguro AutorizacionSeguro[]
  historiaClinica      HistoriaClinica?
  citas                Cita[]
  facturas             Factura[]
  logsAcceso           LogAcceso[]
  recetas              Receta[]
  constancias          ConstanciaMedica[]
  informesMedicos      InformeMedico[]
  presupuestos         Presupuesto[]
  planesEjercicios     PlanEjercicios[]
  usuarioPortal        Usuario?

  @@index([documento])
  @@index([telefono])
  @@map("pacientes")
}

// Relación paciente-aseguradora: permite seguro primario + secundario, cada
// uno con su propio número de afiliación (ej. HCM de PDVSA como primario y
// Sicoprosa como secundario).
model PacienteAseguradora {
  id               String   @id @default(uuid())
  pacienteId       String
  aseguradoraId    String
  numeroAfiliacion String?
  esPrimaria       Boolean  @default(true)
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())

  paciente    Paciente    @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  aseguradora Aseguradora @relation(fields: [aseguradoraId], references: [id])

  @@unique([pacienteId, aseguradoraId])
  @@index([pacienteId])
  @@map("paciente_aseguradoras")
}

// ============================================================
// HISTORIA CLÍNICA
// ============================================================

model HistoriaClinica {
  id                      String    @id @default(uuid())
  pacienteId              String    @unique
  // Fecha de la historia (primera consulta). Puede ser anterior a la creación
  // del registro cuando se transcribe una historia en papel.
  fechaConsulta           DateTime? @db.Date
  motivoConsulta          String?
  enfermedadActual        String? // evolución del cuadro que motiva la consulta
  estudiosComplementarios String? // resultados o estudios solicitados (Rx, RM, EMG...)
  diagnosticoPrincipal    String?
  codigoCIE10             String?
  antecedentesMedicos     String?
  antecedentesQuirurgicos String?
  antecedentesFamiliares  String?
  alergias                String? // medicamentosas, alimentarias, etc. — se muestra como alerta en recetas
  // Anamnesis y plan propios de fisiatría
  ocupacion               String? // oficio/puesto: orienta la ergonomía y el retorno laboral
  dominancia              String? // DIESTRO | ZURDO | AMBIDIESTRO
  actividadFisica         String? // deporte o nivel de actividad habitual
  // Contraindicaciones para agentes físicos (marcapasos, implantes metálicos,
  // embarazo, neoplasia...). Se muestran como alerta a quien aplica la terapia.
  contraindicaciones      String?
  examenFisico            String? // inspección, postura, marcha, palpación, pruebas especiales
  objetivosRehabilitacion String?
  planTerapeutico         String? // modalidades, frecuencia y número de sesiones indicadas
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  paciente         Paciente               @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  evaluaciones     EvaluacionFisiatrica[]
  sesiones         Sesion[]
  adjuntos         Adjunto[]
  logsAcceso       LogAcceso[]
  recetas          Receta[]
  constancias      ConstanciaMedica[]
  informesMedicos  InformeMedico[]
  planesEjercicios PlanEjercicios[]

  @@map("historias_clinicas")
}

// Evaluaciones fisiátricas: EVA, rangos de movimiento, fuerza muscular,
// y escalas funcionales configurables (Barthel, Oswestry, etc.)
model EvaluacionFisiatrica {
  id                String     @id @default(uuid())
  historiaClinicaId String
  evaluadorId       String
  fecha             DateTime   @default(now())
  tipoEscala        TipoEscala
  nombreEscala      String? // usado cuando tipoEscala = PERSONALIZADA
  datos             Json // estructura flexible por tipo de escala
  puntajeTotal      Float?
  observaciones     String?
  createdAt         DateTime   @default(now())

  historiaClinica HistoriaClinica @relation(fields: [historiaClinicaId], references: [id], onDelete: Cascade)
  evaluador       Usuario         @relation("EvaluadorEvaluaciones", fields: [evaluadorId], references: [id])

  @@index([historiaClinicaId])
  @@map("evaluaciones_fisiatricas")
}

// Notas de evolución / línea de tiempo del paciente
model Sesion {
  id                  String           @id @default(uuid())
  historiaClinicaId   String
  citaId              String?          @unique
  terapeutaId         String
  fecha               DateTime         @default(now())
  notaEvolucion       String
  tratamientoAplicado String?
  asistencia          EstadoAsistencia @default(ASISTIO)
  // Dolor (EVA 0-10) al llegar y al terminar la sesión, y agentes físicos /
  // técnicas aplicadas: permiten seguir la respuesta al tratamiento.
  evaPre              Int?
  evaPost             Int?
  modalidades         String[]         @default([])
  createdAt           DateTime         @default(now())

  historiaClinica HistoriaClinica  @relation(fields: [historiaClinicaId], references: [id], onDelete: Cascade)
  terapeuta       Usuario          @relation("TerapeutaSesiones", fields: [terapeutaId], references: [id])
  cita            Cita?            @relation(fields: [citaId], references: [id])
  facturaDetalles FacturaDetalle[]

  @@index([historiaClinicaId])
  @@map("sesiones")
}

model Adjunto {
  id                String      @id @default(uuid())
  historiaClinicaId String
  tipo              TipoAdjunto
  categoria         String? // ej. "Radiografía", "Resonancia", "Foto de postura", "Foto de herida", "Laboratorio"
  nombreArchivo     String
  rutaArchivo       String
  descripcion       String?
  subidoPorId       String
  createdAt         DateTime    @default(now())

  historiaClinica HistoriaClinica @relation(fields: [historiaClinicaId], references: [id], onDelete: Cascade)
  subidoPor       Usuario         @relation("SubidoPorUsuario", fields: [subidoPorId], references: [id])

  @@map("adjuntos")
}

// ============================================================
// AGENDA Y CITAS
// ============================================================

model Cita {
  id                  String     @id @default(uuid())
  pacienteId          String
  profesionalId       String
  tarifaId            String?
  fechaHoraInicio     DateTime
  fechaHoraFin        DateTime
  estado              EstadoCita @default(PROGRAMADA)
  esRecurrente        Boolean    @default(false)
  grupoRecurrenciaId  String? // agrupa un paquete de sesiones (ej. 10 sesiones)
  numeroSesionEnGrupo Int?
  totalSesionesGrupo  Int?
  notas               String?
  recordatorioEnviado Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  paciente        Paciente         @relation(fields: [pacienteId], references: [id])
  profesional     Usuario          @relation("ProfesionalCitas", fields: [profesionalId], references: [id])
  tarifa          Tarifa?          @relation(fields: [tarifaId], references: [id])
  sesion          Sesion?
  facturaDetalles FacturaDetalle[]

  @@index([profesionalId, fechaHoraInicio])
  @@index([pacienteId])
  @@index([grupoRecurrenciaId])
  @@map("citas")
}

model BloqueoHorario {
  id              String   @id @default(uuid())
  profesionalId   String
  fechaHoraInicio DateTime
  fechaHoraFin    DateTime
  motivo          String?
  createdAt       DateTime @default(now())

  profesional Usuario @relation(fields: [profesionalId], references: [id])

  @@index([profesionalId, fechaHoraInicio])
  @@map("bloqueos_horario")
}

// ============================================================
// FACTURACIÓN Y PAGOS
// ============================================================

model Tarifa {
  id             String   @id @default(uuid())
  nombreServicio String // Consulta, Terapia Física, Terapia Ocupacional...
  descripcion    String?
  precio         Decimal  @db.Decimal(10, 2)
  aseguradoraId  String? // si es una tarifa especial de convenio
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())

  aseguradora      Aseguradora?      @relation(fields: [aseguradoraId], references: [id])
  citas            Cita[]
  facturaDetalles  FacturaDetalle[]
  presupuestoItems PresupuestoItem[]

  @@map("tarifas")
}

model Factura {
  id               String        @id @default(uuid())
  numeroFactura    String        @unique
  pacienteId       String
  aseguradoraId    String?
  // Autorización previa que respalda la factura cuando la aseguradora la
  // exige; sus sesiones consumidas se cuentan a partir de estas facturas.
  autorizacionId   String?
  fecha            DateTime      @default(now())
  subtotal         Decimal       @db.Decimal(10, 2)
  impuestos        Decimal       @default(0) @db.Decimal(10, 2)
  total            Decimal       @db.Decimal(10, 2)
  // Reparto aseguradora/paciente congelado al emitir la factura: si luego
  // cambian el % de cobertura o el tope del convenio, las facturas ya
  // emitidas no se recalculan. montoAseguradora es null en facturas particulares.
  montoAseguradora Decimal?      @db.Decimal(10, 2)
  montoPaciente    Decimal       @db.Decimal(10, 2)
  estado           EstadoFactura @default(PENDIENTE)
  notas            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  paciente     Paciente            @relation(fields: [pacienteId], references: [id])
  aseguradora  Aseguradora?        @relation(fields: [aseguradoraId], references: [id])
  autorizacion AutorizacionSeguro? @relation(fields: [autorizacionId], references: [id])
  detalles     FacturaDetalle[]
  pagos        Pago[]

  @@index([pacienteId])
  @@index([estado])
  @@index([autorizacionId])
  @@map("facturas")
}

model FacturaDetalle {
  id             String  @id @default(uuid())
  facturaId      String
  tarifaId       String
  citaId         String?
  sesionId       String?
  descripcion    String?
  cantidad       Int     @default(1)
  precioUnitario Decimal @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)

  factura Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  tarifa  Tarifa  @relation(fields: [tarifaId], references: [id])
  cita    Cita?   @relation(fields: [citaId], references: [id])
  sesion  Sesion? @relation(fields: [sesionId], references: [id])

  @@map("factura_detalles")
}

model Pago {
  id              String     @id @default(uuid())
  facturaId       String
  monto           Decimal    @db.Decimal(10, 2)
  metodoPago      MetodoPago
  fecha           DateTime   @default(now())
  referencia      String?
  // Pago hecho en bolívares: `monto` sigue en dólares (moneda de las tarifas)
  // y aquí queda lo recibido en Bs y la tasa usada para convertirlo.
  montoBs         Decimal?   @db.Decimal(14, 2)
  tasaCambio      Decimal?   @db.Decimal(14, 4)
  registradoPorId String
  // Un pago mal registrado o reembolsado no se borra: se anula y deja de
  // contar para el saldo, los ingresos y el estado de la factura.
  anulado         Boolean    @default(false)
  anuladoEn       DateTime?
  anuladoPorId    String?
  motivoAnulacion String?
  createdAt       DateTime   @default(now())

  factura       Factura  @relation(fields: [facturaId], references: [id])
  registradoPor Usuario  @relation("RegistradoPorUsuario", fields: [registradoPorId], references: [id])
  anuladoPor    Usuario? @relation("AnuladoPorUsuario", fields: [anuladoPorId], references: [id])

  @@index([facturaId])
  @@map("pagos")
}

// ============================================================
// INVENTARIO BÁSICO
// ============================================================

model Insumo {
  id           String   @id @default(uuid())
  nombre       String
  categoria    String?
  stockActual  Int      @default(0)
  stockMinimo  Int      @default(0)
  unidadMedida String? // unidades, cajas, rollos...
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  movimientos MovimientoInsumo[]

  @@map("insumos")
}

model MovimientoInsumo {
  id              String               @id @default(uuid())
  insumoId        String
  tipo            TipoMovimientoInsumo
  cantidad        Int
  motivo          String?
  registradoPorId String
  fecha           DateTime             @default(now())

  insumo        Insumo  @relation(fields: [insumoId], references: [id])
  registradoPor Usuario @relation(fields: [registradoPorId], references: [id])

  @@map("movimientos_insumo")
}

// ============================================================
// EQUIPOS Y MANTENIMIENTO
// ============================================================

enum EstadoEquipo {
  OPERATIVO
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO
  DADO_DE_BAJA
}

enum TipoMantenimiento {
  PREVENTIVO
  CORRECTIVO
  CALIBRACION
}

// Máquinas del consultorio (electroestimulación, ultrasonido, láser,
// magnetoterapia, tracción, compresero...). proximoMantenimiento se
// recalcula al registrar un mantenimiento preventivo o una calibración.
model Equipo {
  id                          String       @id @default(uuid())
  nombre                      String
  categoria                   String?
  marca                       String?
  modelo                      String?
  numeroSerie                 String?      @unique
  ubicacion                   String?
  fechaAdquisicion            DateTime?
  garantiaHasta               DateTime?
  proveedorServicio           String?
  estado                      EstadoEquipo @default(OPERATIVO)
  frecuenciaMantenimientoDias Int?
  ultimoMantenimiento         DateTime?
  proximoMantenimiento        DateTime?
  notas                       String?
  activo                      Boolean      @default(true)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  mantenimientos MantenimientoEquipo[]

  @@map("equipos")
}

model MantenimientoEquipo {
  id              String            @id @default(uuid())
  equipoId        String
  tipo            TipoMantenimiento
  fecha           DateTime
  descripcion     String
  realizadoPor    String?
  costo           Decimal?          @db.Decimal(10, 2)
  registradoPorId String
  createdAt       DateTime          @default(now())

  equipo        Equipo  @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  registradoPor Usuario @relation(fields: [registradoPorId], references: [id])

  @@index([equipoId, fecha])
  @@map("mantenimientos_equipo")
}

// ============================================================
// AUDITORÍA / PRIVACIDAD
// ============================================================

model LogAcceso {
  id                String    @id @default(uuid())
  usuarioId         String
  pacienteId        String?
  historiaClinicaId String?
  accion            AccionLog
  detalle           String?
  ip                String?
  fecha             DateTime  @default(now())

  usuario         Usuario          @relation(fields: [usuarioId], references: [id])
  paciente        Paciente?        @relation(fields: [pacienteId], references: [id])
  historiaClinica HistoriaClinica? @relation(fields: [historiaClinicaId], references: [id])

  @@index([pacienteId])
  @@index([usuarioId])
  @@map("logs_acceso")
}

// ============================================================
// RECETARIO Y DOCUMENTOS CLÍNICOS IMPRIMIBLES
// ============================================================

// Configuración de membrete/firma de cada médico, usada al generar PDFs
model PerfilMedico {
  id                   String   @id @default(uuid())
  usuarioId            String   @unique
  colegiatura          String? // N° MPPS
  cma                  String? // N° de Colegio de Médicos del estado
  rif                  String?
  instagram            String? // ej. "@dra.fisya"
  tituloProfesional    String? // ej. "Médico Fisiatra"
  nombreConsultorio    String   @default("LilyMedical")
  direccionConsultorio String?
  telefonoConsultorio  String?
  firmaUrl             String? // ruta del archivo de imagen de firma
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("perfiles_medico")
}

model Receta {
  id                    String     @id @default(uuid())
  numeroReceta          String     @unique
  pacienteId            String
  historiaClinicaId     String
  medicoId              String
  tipo                  TipoReceta
  diagnostico           String?
  indicacionesGenerales String?
  fechaVencimiento      DateTime? // para tratamientos crónicos repetibles
  codigoVerificacion    String     @unique @default(uuid())
  fecha                 DateTime   @default(now())
  createdAt             DateTime   @default(now())

  paciente        Paciente        @relation(fields: [pacienteId], references: [id])
  historiaClinica HistoriaClinica @relation(fields: [historiaClinicaId], references: [id])
  medico          Usuario         @relation("MedicoRecetas", fields: [medicoId], references: [id])
  items           ItemReceta[]

  @@index([pacienteId])
  @@map("recetas")
}

// Ítem de una receta: campos de medicamento o de orden de terapia,
// según el `tipo` de la receta a la que pertenece
model ItemReceta {
  id            String  @id @default(uuid())
  recetaId      String
  orden         Int     @default(0)
  // Campos para tipo MEDICAMENTO
  medicamento   String?
  presentacion  String?
  dosis         String?
  frecuencia    String?
  duracion      String?
  // Campos para tipo ORDEN_TERAPIA
  tipoTerapia   String?
  sesiones      Int?
  observaciones String?

  receta Receta @relation(fields: [recetaId], references: [id], onDelete: Cascade)

  @@map("items_receta")
}

model ConstanciaMedica {
  id                 String    @id @default(uuid())
  numeroConstancia   String    @unique
  pacienteId         String
  historiaClinicaId  String
  medicoId           String
  diagnostico        String?
  codigoCIE10        String?
  diasReposo         Int?
  fechaInicioReposo  DateTime?
  fechaFinReposo     DateTime?
  motivo             String
  codigoVerificacion String    @unique @default(uuid())
  fecha              DateTime  @default(now())
  createdAt          DateTime  @default(now())

  paciente        Paciente        @relation(fields: [pacienteId], references: [id])
  historiaClinica HistoriaClinica @relation(fields: [historiaClinicaId], references: [id])
  medico          Usuario         @relation("MedicoConstancias", fields: [medicoId], references: [id])

  @@index([pacienteId])
  @@map("constancias_medicas")
}

// ============================================================
// FAVORITOS DE RECETA Y PLANES DE EJERCICIOS
// ============================================================

// Favoritos por médico para autocompletar ítems de receta frecuentes
// (medicamentos u órdenes de terapia habituales).
model PlantillaReceta {
  id            String     @id @default(uuid())
  usuarioId     String
  tipo          TipoReceta
  medicamento   String?
  presentacion  String?
  dosis         String?
  frecuencia    String?
  duracion      String?
  tipoTerapia   String?
  sesiones      Int?
  observaciones String?
  createdAt     DateTime   @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("plantillas_receta")
}

// Catálogo compartido de ejercicios (independiente del paciente), usado para
// armar planes de terapia física en casa.
model PlantillaEjercicio {
  id                    String   @id @default(uuid())
  nombre                String
  categoria             String? // ej. "Columna lumbar", "Hombro", "Rodilla"
  descripcion           String?
  repeticionesSugeridas String? // ej. "3 series x 15 repeticiones"
  createdAt             DateTime @default(now())

  @@map("plantillas_ejercicio")
}

// Plan de ejercicios armado para un paciente, imprimible como hoja de
// indicaciones (terapia en casa).
model PlanEjercicios {
  id                String   @id @default(uuid())
  pacienteId        String
  historiaClinicaId String
  medicoId          String
  fecha             DateTime @default(now())
  notas             String?
  createdAt         DateTime @default(now())

  paciente        Paciente            @relation(fields: [pacienteId], references: [id])
  historiaClinica HistoriaClinica     @relation(fields: [historiaClinicaId], references: [id])
  medico          Usuario             @relation("MedicoPlanesEjercicios", fields: [medicoId], references: [id])
  items           ItemPlanEjercicio[]

  @@index([pacienteId])
  @@map("planes_ejercicios")
}

model ItemPlanEjercicio {
  id                    String  @id @default(uuid())
  planId                String
  orden                 Int     @default(0)
  nombre                String
  descripcion           String?
  repeticionesSugeridas String?

  plan PlanEjercicios @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("items_plan_ejercicios")
}

// Fotos de la galería pública de la landing. Se suben desde la app (no se
// versionan en el repositorio) y se guardan en `uploads/galeria`; el archivo
// físico se sirve estático porque la galería es contenido público.
model FotoGaleria {
  id             String   @id @default(uuid())
  archivo        String   @unique // nombre del archivo dentro de uploads/galeria
  nombreOriginal String
  pie            String // pie de foto y texto alternativo de la imagen
  orden          Int      @default(0)
  visible        Boolean  @default(true)
  subidoPorId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subidoPor Usuario? @relation("UsuarioFotosGaleria", fields: [subidoPorId], references: [id], onDelete: SetNull)

  @@index([visible, orden])
  @@map("fotos_galeria")
}

// Correlativos por serie y año (facturas, recetas, constancias). Se
// incrementan con un único INSERT ... ON CONFLICT atómico (ver
// src/lib/correlativos.ts) para que dos documentos emitidos a la vez nunca
// reciban el mismo número.
// Informe médico en el formato del talonario (media carta): texto libre
// del médico y lo que se plantea a seguir.
model InformeMedico {
  id                String   @id @default(uuid())
  numeroInforme     String   @unique
  pacienteId        String
  historiaClinicaId String
  medicoId          String
  informe           String // cifrado en reposo
  indicaciones      String? // "Se plantea": conducta a seguir, cifrado en reposo
  fecha             DateTime @default(now())
  createdAt         DateTime @default(now())

  paciente        Paciente        @relation(fields: [pacienteId], references: [id])
  historiaClinica HistoriaClinica @relation(fields: [historiaClinicaId], references: [id])
  medico          Usuario         @relation("MedicoInformes", fields: [medicoId], references: [id])

  @@index([pacienteId])
  @@map("informes_medicos")
}

// Presupuesto de tratamiento para el paciente, en dólares y su equivalente
// en bolívares a la tasa BCV del día en que se emite. No es una factura: no
// mueve saldos ni cuenta como ingreso.
model Presupuesto {
  id                String   @id @default(uuid())
  numeroPresupuesto String   @unique
  pacienteId        String
  creadoPorId       String
  fecha             DateTime @default(now())
  diagnostico       String? // IDX que se imprime en el presupuesto, cifrado en reposo
  tasaCambio        Decimal? @db.Decimal(14, 4) // Bs por dólar (BCV)
  total             Decimal  @db.Decimal(10, 2)
  notas             String?
  anulado           Boolean  @default(false)
  createdAt         DateTime @default(now())

  paciente  Paciente          @relation(fields: [pacienteId], references: [id])
  creadoPor Usuario           @relation("PresupuestosCreados", fields: [creadoPorId], references: [id])
  items     PresupuestoItem[]

  @@index([pacienteId])
  @@map("presupuestos")
}

model PresupuestoItem {
  id             String  @id @default(uuid())
  presupuestoId  String
  tarifaId       String?
  descripcion    String
  cantidad       Int
  precioUnitario Decimal @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)

  presupuesto Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  tarifa      Tarifa?     @relation(fields: [tarifaId], references: [id])

  @@index([presupuestoId])
  @@map("presupuesto_items")
}

model Correlativo {
  serie String @id // ej. "LM-2026", "RX-2026", "CM-2026"
  valor Int

  @@map("correlativos")
}

enum TipoAvisoPortada {
  DEDICATORIA
  COMERCIAL
}

// Ventana emergente que se muestra al entrar a la portada. Como mucho uno
// está activo a la vez (se garantiza en el servicio y con un índice único
// parcial en la migración). La dedicatoria original de cumpleaños se
// conserva como registro histórico: se puede activar o desactivar, pero no
// editar ni borrar.
model AvisoPortada {
  id          String           @id @default(uuid())
  tipo        TipoAvisoPortada @default(COMERCIAL)
  etiqueta    String? // texto pequeño sobre el título ("Promoción", "Dedicatoria")
  titulo      String
  mensaje     String // párrafos separados por una línea en blanco
  firma       String?
  textoBoton  String           @default("Entrar al sitio")
  enlaceUrl   String? // opcional: botón de acción (WhatsApp, #servicios...)
  enlaceTexto String?
  activo      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("avisos_portada")
}
